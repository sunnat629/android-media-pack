#!/usr/bin/env bash
# CLI for installing android-media-skill into local projects.

set -euo pipefail

DEFAULT_REPO_URL="https://github.com/sunnat629/android-media-skill"
DEFAULT_REF="main"

usage() {
    cat <<'USAGE'
android-media-skill <command> [args]

Commands:
  install [target-project] [repo-url] [ref]   Install media skills into .skills/media
  update  [target-project] [repo-url] [ref]   Same as install
  list    [target-project]                    List installed media skills
  doctor  [target-project]                    Check local .skills/media
  help                                      Show this help

Examples:
  android-media-skill install .
  android-media-skill install ../MyApp https://github.com/sunnat629/android-media-skill main
  android-media-skill list .
USAGE
}

archive_url_for() {
    repo_url="${1%.git}"
    repo_url="${repo_url%/}"
    ref="$2"
    ref_type="${MEDIA_SKILLS_REF_TYPE:-heads}"
    printf '%s/archive/refs/%s/%s.tar.gz\n' "$repo_url" "$ref_type" "$ref"
}

install_skills() {
    target_project="${1:-.}"
    repo_url="${2:-$DEFAULT_REPO_URL}"
    ref="${3:-$DEFAULT_REF}"
    archive_url="${MEDIA_SKILLS_ARCHIVE_URL:-$(archive_url_for "$repo_url" "$ref")}"

    target_project="$(cd "$target_project" && pwd)"
    dest="$target_project/.skills/media"
    tmp="$(mktemp -d)"

    cleanup() {
        rm -rf "$tmp"
    }
    trap cleanup EXIT

    curl -fsSL "$archive_url" | tar -xz -C "$tmp"

    media_dir="$(find "$tmp" -type d -path '*/.skills/media' -print -quit)"
    if [ -z "$media_dir" ]; then
        echo "No .skills/media folder found in archive: $archive_url" >&2
        exit 1
    fi

    rm -rf "$dest"
    mkdir -p "$dest"
    cp -R "$media_dir"/. "$dest"/

    count="$(find "$dest" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')"
    echo "Installed $count media skills to $dest"
}

list_skills() {
    target_project="${1:-.}"
    media_dir="$(cd "$target_project" && pwd)/.skills/media"

    if [ ! -d "$media_dir" ]; then
        echo "No .skills/media folder found: $media_dir" >&2
        exit 1
    fi

    find "$media_dir" -mindepth 2 -maxdepth 2 -name SKILL.md \
        | sed "s#^$media_dir/##; s#/SKILL.md\$##" \
        | sort
}

doctor() {
    target_project="${1:-.}"
    media_dir="$(cd "$target_project" && pwd)/.skills/media"

    if [ ! -d "$media_dir" ]; then
        echo "missing: $media_dir" >&2
        exit 1
    fi

    count="$(find "$media_dir" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')"
    if [ "$count" -eq 0 ]; then
        echo "no skills found in $media_dir" >&2
        exit 1
    fi

    echo "ok: $count media skills in $media_dir"
}

command="${1:-help}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command" in
    install|update)
        install_skills "$@"
        ;;
    list)
        list_skills "$@"
        ;;
    doctor)
        doctor "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
